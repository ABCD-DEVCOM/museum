   '<tr><td width="30%"><strong>Receipt ID:</strong></td><td>'v1'</td></tr>'
   '<tr><td><strong>Date:</strong></td><td>'v20'</td></tr>'
   '<tr><td><strong>Depositor Name:</strong></td><td>'v30'</td></tr>'
   (if p(v40) then '<tr><td><strong>Contact Info:</strong></td><td>Email: 'v40^a,' | Phone: 'v40^b'</td></tr>' fi/)
'</table>'

'<h3>Objects Involved</h3>'

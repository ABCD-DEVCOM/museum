'<h3>Terms & Conditions</h3>'
'<p style="text-align:justify; font-size:0.9em; border:1px solid #ccc; padding:10px;">'
   v70,
   (if a(v70) then 'Standard terms of responsibility apply as governed by the museum policy.' fi/)
'</p>'


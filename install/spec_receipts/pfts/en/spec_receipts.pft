'<div style="background:#f9f9f9; padding:15px; margin-bottom:10px; border:1px solid #ccc; border-radius:5px; font-family:sans-serif;">'
   '<div style="font-size:1.2em; border-bottom:1px solid #ddd; padding-bottom:5px; margin-bottom:10px;">'
      '<strong>Receipt: </strong>'v1/
      '<span style="float:right; font-size:0.8em; color:#666;">Type: 'v10'</span>'
   '</div>'

   '<div><strong>Date: </strong> 'v20'</div>'
   '<div><strong>Depositor/Owner: </strong> 'v30'</div>'
   (if p(v40) then '<div><strong>Contact: </strong> 'v40^a,' / ',v40^b,'</div>' fi/)
   
   '<div style="margin-top:10px; background:#fff; padding:10px; border:1px solid #eee;">'
      '<strong>Associated Objects (Spectrum IDs):</strong><br>'
      (if p(v50) then '- 'v50'<br>' fi/)
   '</div>'
   
   (if p(v60) then '<div style="margin-top:10px;"><strong>Reason: </strong> 'v60'</div>' fi/)
   (if p(v80) then '<div style="margin-top:10px; font-style:italic;"><strong>Processed by: </strong> 'v80'</div>' fi/)
'</div>'